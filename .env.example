# Blank to Bold — environment variables
#
# Copy to `.env.local` for local development (`.env.local` is gitignored;
# never commit real secrets). Variables are grouped by when they become
# required — see docs/13-backend-architecture.md for the design these map to.
# None of the backend variables below are consumed by any code yet
# (Prisma/Better Auth/storage are designed, not implemented — see
# docs/17-engineering-review.md).

# -----------------------------------------------------------------------------
# Currently used
# -----------------------------------------------------------------------------

# Canonical site URL. Used for absolute URLs in metadata (Open Graph, canonical
# links, sitemap). Falls back to http://localhost:3000 if unset — see
# src/app/layout.tsx. Must be the real production URL in production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Database (Prisma + PostgreSQL) — not yet implemented, see docs/14
# -----------------------------------------------------------------------------

# Postgres connection string Prisma will use. Standard
# postgres://user:password@host:port/database format.
DATABASE_URL="postgresql://user:password@localhost:5432/blank_to_bold"

# -----------------------------------------------------------------------------
# Authentication (Better Auth, Studio only) — not yet implemented, see docs/13
# -----------------------------------------------------------------------------

# Random 32+ byte secret Better Auth uses to sign sessions/cookies. Generate
# with `openssl rand -base64 32`. Never reuse across environments.
BETTER_AUTH_SECRET=""

# Base URL Better Auth uses to build callback/redirect URLs. Same value as
# NEXT_PUBLIC_SITE_URL in most setups, kept separate because Better Auth reads
# it server-side and the two are allowed to diverge (e.g. behind a proxy).
BETTER_AUTH_URL="http://localhost:3000"

# -----------------------------------------------------------------------------
# Storage — local now, StorageAdapter designed to swap providers via config
# (see docs/13-backend-architecture.md#storage-swappable-from-day-one-without-a-rewrite)
# -----------------------------------------------------------------------------

# Which StorageAdapter implementation is active: "local" | "cloudinary" | "s3".
STORAGE_PROVIDER="local"

# Only read when STORAGE_PROVIDER=local. Filesystem path (relative to project
# root) uploaded media is written to in development.
STORAGE_LOCAL_PATH="./public/uploads"

# Only read when STORAGE_PROVIDER=cloudinary. Unused until CloudinaryAdapter
# is implemented.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Only read when STORAGE_PROVIDER=s3. Unused until S3Adapter is implemented.
S3_BUCKET_NAME=""
S3_REGION=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
